<UserControl x:Class="Decorlim.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.45*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Usuarios y Control de Roles" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                <DataGrid x:Name="GridUsuarios"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionChanged="GridUsuarios_SelectionChanged"
                          HeadersVisibility="Column"
                          BorderBrush="#E2E8F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Login}" Width="125"/>
                        <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="120"/>
                        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtTituloUsuario" Text="Nuevo Usuario" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                <TextBlock Text="Usuario (Login) *" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="TxtLogin" Height="32" Padding="8,4" Margin="0,3,0,8"/>

                <TextBlock Text="Nombre Completo *" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox x:Name="TxtNombreCompleto" Height="32" Padding="8,4" Margin="0,3,0,8"/>

                <TextBlock Text="Rol del Sistema" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                <ComboBox x:Name="CmbRol" Height="32" Margin="0,3,0,8" SelectedIndex="1">
                    <ComboBoxItem Content="Administrador"/>
                    <ComboBoxItem Content="Vendedor"/>
                </ComboBox>

                <TextBlock x:Name="TxtEtiquetaPassword" Text="Contraseña *" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                <PasswordBox x:Name="TxtPassword" Height="32" Padding="8,4" Margin="0,3,0,10"/>

                <CheckBox x:Name="ChkUsuarioActivo" Content="Usuario Activo" IsChecked="True" Margin="0,0,0,14"/>

                <Button Content="➕ Limpiar / Nuevo Usuario"
                        Height="34"
                        Margin="0,0,0,8"
                        Background="#0284C7"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnNuevo_Click"/>

                <Button x:Name="BtnGuardarUsuario"
                        Content="💾 Guardar Usuario"
                        Height="40"
                        Background="#16A34A"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnGuardar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>