<Window x:Class="Decorlim.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DECORLIM POS - Sistema de Gestión"
        Width="1280" Height="780"
        MinWidth="1024" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior -->
        <Border Grid.Row="0" Background="#0F172A" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DECORLIM" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,12,0"/>
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EtiquetaRol}" Foreground="#60A5FA" FontSize="11.5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UsuarioActual.NombreCompleto}" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="Sincronizar"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnSincronizar_Click"/>
                    <Button Content="Cerrar Sesión"
                            Padding="10,5"
                            Background="#334155"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCerrarSesion_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pestañas Principales -->
        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Margin="12,10,12,6"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem x:Name="TabDashboard" Header="  📊 Dashboard  " FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="HostDashboard"/>
            </TabItem>
            <TabItem x:Name="TabVentas" Header="  🛒 Punto de Venta (POS)  " FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="HostVentas"/>
            </TabItem>
            <TabItem x:Name="TabInventario" Header="  📦 Inventario  " FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="HostInventario"/>
            </TabItem>
            <TabItem x:Name="TabEtiquetas" Header="  🏷️ Etiquetas  " FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="HostEtiquetas"/>
            </TabItem>
            <TabItem x:Name="TabClientes" Header="  👥 Clientes  " FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="HostClientes"/>
            </TabItem>
            <TabItem x:Name="TabComprobantes" Header="  🧾 Comprobantes SRI  " FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="HostComprobantes"/>
            </TabItem>
            <TabItem x:Name="TabUsuarios" Header="  🔐 Usuarios y Roles  " FontSize="13" FontWeight="SemiBold">
                <Grid x:Name="HostUsuarios"/>
            </TabItem>
        </TabControl>

        <!-- Barra de Estado Inferior -->
        <Border Grid.Row="2" Background="#E2E8F0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding EstadoBarra}" Foreground="#334155" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ColaOfflineTexto}" Foreground="#B45309" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <TextBlock Grid.Column="2" Text="{Binding EstadoConexionTexto}" Foreground="#0F172A" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>