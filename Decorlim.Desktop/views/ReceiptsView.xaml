<UserControl x:Class="Decorlim.Desktop.Views.ReceiptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Border Margin="14" Background="White" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Comprobantes Emitidos (Facturas SRI y Notas de Venta)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Consulta el historial y reimprime comprobantes con datos del cliente y forma de pago" FontSize="12" Foreground="#64748B"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 Actualizar" Height="35" Padding="14,0" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnActualizar_Click"/>
                <Button Grid.Column="3" Content="🖨️ Reimprimir Seleccionado" Height="35" Padding="14,0" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnReimprimir_Click"/>
            </Grid>

            <DataGrid x:Name="GridComprobantes"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      BorderBrush="#E2E8F0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Secuencial" Binding="{Binding Secuencial}" Width="145"/>
                    <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                    <DataGridTextColumn Header="RUC / CI" Binding="{Binding Identificacion}" Width="120"/>
                    <DataGridTextColumn Header="Pago" Binding="{Binding MetodoPago}" Width="105"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="85"/>
                    <DataGridTextColumn Header="Estado SRI" Binding="{Binding EstadoSri}" Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>