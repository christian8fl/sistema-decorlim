<UserControl x:Class="Decorlim.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="GridBase" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
        <StackPanel>
            <!-- Encabezado y Acciones de Descarga PDF -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Dashboard, Reportes y Cierre de Caja (Z)"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>
                    <TextBlock Text="Filtra por período o rango de fechas, consulta el cuadre de caja y descarga el cierre o detalle de productos en PDF (Atajo: F5)"
                               FontSize="12"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🧾 Cierre / Resumen (PDF)"
                            Style="{StaticResource ActionButton}"
                            Background="#0F766E"
                            Margin="0,0,8,0"
                            Click="BtnExportarResumenPdf_Click"/>
                    <Button Content="📄 Detalle Ventas (PDF)"
                            Style="{StaticResource ActionButton}"
                            Background="#0284C7"
                            Margin="0,0,8,0"
                            Click="BtnExportarDetallePdf_Click"/>
                    <Button Content="🔄 Actualizar (F5)"
                            Style="{StaticResource ActionButton}"
                            Padding="14,0"
                            Background="#2563EB"
                            Click="BtnActualizar_Click"/>
                </StackPanel>
            </Grid>

            <!-- Barra de Filtros: Período, Desde/Hasta y Búsqueda -->
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Período:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbPeriodo"
                                  Grid.Column="2"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  SelectedIndex="0"
                                  SelectionChanged="CmbPeriodo_SelectionChanged">
                            <ComboBoxItem Content="Diario"/>
                            <ComboBoxItem Content="Semanal"/>
                            <ComboBoxItem Content="Mensual"/>
                            <ComboBoxItem Content="Anual"/>
                            <ComboBoxItem Content="Personalizado"/>
                        </ComboBox>

                        <TextBlock Grid.Column="4" Text="Desde:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        <DatePicker x:Name="DpDesde"
                                    Grid.Column="6"
                                    Height="32"
                                    VerticalContentAlignment="Center"
                                    SelectedDateChanged="FechaFiltro_Changed"/>

                        <TextBlock Grid.Column="8" Text="Hasta:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                        <DatePicker x:Name="DpHasta"
                                    Grid.Column="10"
                                    Height="32"
                                    VerticalContentAlignment="Center"
                                    SelectedDateChanged="FechaFiltro_Changed"/>

                        <Grid Grid.Column="12" VerticalAlignment="Center">
                            <TextBox x:Name="TxtBuscarVenta"
                                     Height="32"
                                     Padding="10,6"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtBuscarVenta_TextChanged"/>
                            <TextBlock Text="Buscar secuencial, cliente, pago o estado..."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtBuscarVenta}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="14"
                                Content="Hoy"
                                Height="32"
                                Padding="14,0"
                                Background="#E2E8F0"
                                Foreground="#0F172A"
                                FontSize="12"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnHoy_Click"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="TxtEtiquetaRango"
                                   Text="Mostrando ventas del día de hoy"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#1E40AF"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Tarjetas KPI -->
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="VENTAS DEL PERÍODO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtVentasHoy" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtCantidadVentas" Text="0 comprobantes en rango" FontSize="11.5" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="EFECTIVO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtEfectivoHoy" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#15803D" Margin="0,6,0,4"/>
                        <TextBlock Text="Caja física esperada" FontSize="11.5" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TRANSFERENCIAS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTransferenciaHoy" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,6,0,4"/>
                        <TextBlock Text="Pagos bancarios registrados" FontSize="11.5" Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="IVA 15% / TICKET PROM." FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTicketPromedio" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,4"/>
                        <TextBlock x:Name="TxtIvaPeriodo" Text="IVA 15% del período: $0.00" FontSize="11.5" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Tablas Inferiores -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>

                <!-- Stock Crítico -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="⚠️ Productos con Stock Bajo (≤ 5)" FontSize="14" FontWeight="Bold" Foreground="#B91C1C" Margin="0,0,0,10"/>
                        <DataGrid x:Name="GridStockBajo"
                                  Style="{StaticResource GridBase}"
                                  Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="85"/>
                                <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Pres." Binding="{Binding Presentacion}" Width="75"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockActual}" Width="60" ElementStyle="{StaticResource RightAlignedCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Ventas / Comprobantes del Rango -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🧾 Comprobantes y Detalle en el Rango Seleccionado" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <DataGrid x:Name="GridComprobantesRecientes"
                                  Style="{StaticResource GridBase}"
                                  Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha/Hora" Binding="{Binding FechaHora, StringFormat=dd/MM/yy HH:mm}" Width="115"/>
                                <DataGridTextColumn Header="Secuencial" Binding="{Binding Secuencial}" Width="150"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="Pago" Binding="{Binding MetodoPago}" Width="95"/>
                                <DataGridTextColumn Header="IVA" Binding="{Binding Iva, StringFormat=C2}" Width="75" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="85" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding EstadoSri}" Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>