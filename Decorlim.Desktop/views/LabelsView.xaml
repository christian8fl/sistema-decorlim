<UserControl x:Class="Decorlim.Desktop.Views.LabelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1.25*"/>
        </Grid.ColumnDefinitions>

        <!-- Selección y Lote de Etiquetas -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Generador de Etiquetas y Códigos de Barras" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtBuscarProd" Grid.Column="0" Height="32" Padding="8,4" TextChanged="TxtBuscarProd_TextChanged"/>
                    <TextBox x:Name="TxtCopias" Grid.Column="2" Height="32" Padding="8,4" Text="1" ToolTip="Cantidad de etiquetas"/>
                    <Button Grid.Column="4" Content="+ Al Lote" Height="32" Padding="12,0" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnAgregarAlLote_Click"/>
                </Grid>

                <DataGrid x:Name="GridProductosEtiqueta"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="GridProductosEtiqueta_SelectionChanged"
                          HeadersVisibility="Column"
                          BorderBrush="#E2E8F0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="110"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Pres." Binding="{Binding Presentacion}" Width="90"/>
                        <DataGridTextColumn Header="PVP" Binding="{Binding PrecioMinorista, StringFormat=C2}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" Text="Lote Listo para Imprimir" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,12,0,6"/>

                <DataGrid x:Name="GridLote"
                          Grid.Row="4"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          BorderBrush="#CBD5E1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" IsReadOnly="True" Width="105"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Copias" Binding="{Binding Copias, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                        <DataGridTemplateColumn Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Foreground="#DC2626" Background="Transparent" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnQuitarLote_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Vista Previa de Etiqueta e Impresión -->
        <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Vista Previa de Etiqueta" FontSize="17" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <Border Width="290"
                        Background="White"
                        BorderBrush="#0F172A"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="14"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="DECORLIM" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="#0F172A"/>
                        <TextBlock x:Name="TxtPreviewNombre" Text="Seleccione un producto" FontWeight="SemiBold" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtPreviewPresentacion" Text="Presentación" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <Image x:Name="ImgBarcodePreview" Width="230" Height="64" Stretch="Uniform" HorizontalAlignment="Center"/>

                        <TextBlock x:Name="TxtPreviewPrecio" Text="PVP: $0.00" FontWeight="Bold" FontSize="15" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ChkMostrarMayorista"
                          Content="Incluir precio mayorista en la etiqueta"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,14"
                          Checked="ChkMostrarMayorista_Changed"
                          Unchecked="ChkMostrarMayorista_Changed"/>

                <Button Content="🖨️ IMPRIMIR LOTE DE ETIQUETAS"
                        Height="42"
                        Width="290"
                        Background="#16A34A"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnImprimirLote_Click"/>

                <Button Content="Limpiar Lote"
                        Height="32"
                        Width="290"
                        Margin="0,8,0,0"
                        Background="#E2E8F0"
                        Foreground="#1E293B"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnLimpiarLote_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>