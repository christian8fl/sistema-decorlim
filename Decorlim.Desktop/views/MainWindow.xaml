<Window x:Class="Decorlim.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DECORLIM POS v1.0 - Sucursal Apuela" Height="450" Width="750"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F4F6F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Panel Izquierdo: Branding Sucursal Apuela -->
        <Border Background="#1E293B" Padding="30">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DECORLIM" Foreground="#38BDF8" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="SISTEMA DE GESTIÓN" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,15"/>
                <TextBlock Text="Control de inventarios, facturación offline y ventas con códigos de barras para pinturas en Apuela."
                           Foreground="#94A3B8" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
                <Border Background="#334155" Padding="12" CornerRadius="6" Margin="0,25,0,0">
                    <TextBlock Text="Modo: Offline-First&#x0a;Base de Datos Local: ACTIVA"
                               Foreground="#34D399" FontSize="11" LineHeight="16"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Panel Derecho: Formulario de Login -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="35">
            <TextBlock Text="Iniciar Sesión" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,22"/>

            <TextBlock Text="Usuario (Login):" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="txtUsuario" Height="36" Padding="8,0" FontSize="14"
                     VerticalContentAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="Contraseña:" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <PasswordBox x:Name="txtPassword" Height="36" Padding="8,0" FontSize="14"
                         VerticalContentAlignment="Center" Margin="0,0,0,24"/>

            <Button x:Name="btnIngresar" Content="INGRESAR AL SISTEMA [Enter]" Height="42"
                    Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="13"
                    Cursor="Hand" Click="BtnIngresar_Click"/>
        </StackPanel>
    </Grid>
</Window>